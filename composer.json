{
    "name": "two13tec/flow-shell-completion",
    "type": "neos-package",
    "description": "Shell completion support for Neos Flow CLI commands (zsh, fish, nix/home-manager)",
    "keywords": ["flow", "neos", "cli", "completion", "zsh", "fish", "shell", "nix"],
    "license": "MIT",
    "authors": [
        {
            "name": "Steffen Beyer, 213tec"
        }
    ],
    "require": {
        "neos/flow": "^8.0 || ^9.0"
    },
    "require-dev": {
        "phpunit/phpunit": "~9.1",
        "squizlabs/php_codesniffer": "^3.13",
        "friendsofphp/php-cs-fixer": "^3.87"
    },
    "autoload": {
        "psr-4": {
            "Two13Tec\\FlowShellCompletion\\": "Classes/"
        }
    },
    "extra": {
        "neos": {
            "package-key": "Two13Tec.FlowShellCompletion"
        }
    }
}
